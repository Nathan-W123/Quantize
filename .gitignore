# Python bytecode/cache
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/

# Tooling caches (all consolidated under .cache/)
.cache/
.pytest_tmp/
.pytest_cache/
.pytest_cache_local/
pytest-cache-files-*/
pytest-of-*/
.mypy_cache/
.ipynb_checkpoints/
.pycache_tmp/
.claude/
~$*

# Pytest tmp_path and miscellaneous tool scratch dirs in project root
tmp*/
codex_tmp/

# Logs
*.log

# Generated run artifacts
orca_workdir/
multistart_runs/
energy_minimize_runs/
bayes_tune_ocs_orca/

# Local generated output (runs, benchmarks, QM scratch).
#
# Benchmark RESULTS are not scratch -- one accuracy-upgrades sweep is hours of
# CPU -- so they are archived into reports/accuracy_upgrades/, which is
# tracked. Run scripts/archive_benchmark_results.py and commit the output
# rather than leaving a number that cost hours sitting in an ignored
# directory.
output/*
!output/.gitkeep
!output/**/.gitkeep

# Legacy output locations (pre-output/ consolidation)
runs/
results/
trials/

# ORCA scratch files (often written with workdir=. or under multistart_runs/)
quantize_orca.inp
quantize_orca.engrad
quantize_orca.hess
quantize_orca.out
quantize_orca.err
quantize_orca_rovib.out
quantize_orca.vpt2
